APP_NAME=RentFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8021
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
